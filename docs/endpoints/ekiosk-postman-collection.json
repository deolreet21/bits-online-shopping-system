{
  "info": {
    "name": "e-Kiosk Online Shopping System",
    "description": "Complete API collection for the BITS e-Kiosk project.\n\nBase URL: http://localhost:8080\n\nAuth: Session cookie (JSESSIONID). Run 'POST /login' first — the cookie is set automatically in Bruno from the Set-Cookie response header.\n\nAccess levels:\n  PUBLIC   = no login required\n  CUSTOMER = any logged-in user\n  ADMIN    = role must be ADMIN",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "sessionId",
      "value": "",
      "type": "string",
      "description": "Paste JSESSIONID value from the Set-Cookie header after running POST /login"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "GET / (root redirect)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Root redirect. No session → /login. ADMIN → /admin/dashboard. CUSTOMER → /customer/dashboard.\nAccess: PUBLIC"
          }
        },
        {
          "name": "GET /login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "Renders the login form. Already logged-in users are redirected to their dashboard.\nAccess: PUBLIC\nOutput: login.html"
          }
        },
        {
          "name": "POST /login — as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin", "type": "text" },
                { "key": "password", "value": "admin123", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "Authenticates the user. On success sets JSESSIONID cookie and redirects to /admin/dashboard.\nAccess: PUBLIC\nOutput: 302 redirect"
          }
        },
        {
          "name": "POST /login — as customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "alice", "type": "text" },
                { "key": "password", "value": "password123", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "description": "Authenticates as customer. On success sets JSESSIONID cookie and redirects to /customer/dashboard.\nAccess: PUBLIC\nOutput: 302 redirect"
          }
        },
        {
          "name": "GET /register",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            },
            "description": "Renders the registration form. Redirects to / if already logged in.\nAccess: PUBLIC\nOutput: register.html"
          }
        },
        {
          "name": "POST /register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "riya", "type": "text" },
                { "key": "email", "value": "riya@example.com", "type": "text" },
                { "key": "password", "value": "riya1234", "type": "text" },
                { "key": "confirmPassword", "value": "riya1234", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            },
            "description": "Creates a new CUSTOMER account. Validates: passwords match, password >= 6 chars, username/email unique. BCrypt-hashes password before saving.\nAccess: PUBLIC\nSuccess: 302 → /login\nFailure: 302 → /register with flash error"
          }
        },
        {
          "name": "GET /logout",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            },
            "description": "Invalidates the HttpSession. Clears all session data.\nAccess: CUSTOMER\nOutput: 302 → /login with flash success"
          }
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "GET /customer/dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "dashboard"]
            },
            "description": "Customer home page. Shows cartCount, totalOrders, last 5 orders. ADMINs are redirected to /admin/dashboard.\nAccess: CUSTOMER\nOutput: customer/dashboard.html"
          }
        },
        {
          "name": "GET /customer/profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/customer/profile",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "profile"]
            },
            "description": "View own profile — username, email, orderCount, feedbackCount, cartCount.\nAccess: CUSTOMER\nOutput: customer/profile.html"
          }
        },
        {
          "name": "POST /customer/profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "alice_updated", "type": "text" },
                { "key": "email", "value": "alice@example.com", "type": "text" },
                { "key": "newPassword", "value": "", "type": "text", "description": "Leave blank to keep current password" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/customer/profile",
              "host": ["{{baseUrl}}"],
              "path": ["customer", "profile"]
            },
            "description": "Update own username, email, and optionally password. Validates uniqueness. Updates session object after save.\nAccess: CUSTOMER\nSuccess: 302 → /customer/profile with flash successMessage\nFailure: 302 → /customer/profile with flash errorMessage"
          }
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "GET /products — all",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            },
            "description": "Browse all products.\nAccess: CUSTOMER\nOutput: products/list.html with products list, categories"
          }
        },
        {
          "name": "GET /products — keyword search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?keyword=mouse",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "keyword", "value": "mouse" }
              ]
            },
            "description": "Search products by name (case-insensitive substring match).\nAccess: CUSTOMER"
          }
        },
        {
          "name": "GET /products — category filter",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?category=ELECTRONICS",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "category", "value": "ELECTRONICS", "description": "One of: ELECTRONICS, ELECTRICAL, FURNITURE, COSMETICS, TOYS, BOOKS" }
              ]
            },
            "description": "Filter products by category.\nAccess: CUSTOMER"
          }
        },
        {
          "name": "GET /products — keyword + category",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products?keyword=lamp&category=ELECTRICAL",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "keyword", "value": "lamp" },
                { "key": "category", "value": "ELECTRICAL" }
              ]
            },
            "description": "Combined keyword + category filter.\nAccess: CUSTOMER"
          }
        },
        {
          "name": "GET /products/search",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/search?keyword=chair",
              "host": ["{{baseUrl}}"],
              "path": ["products", "search"],
              "query": [
                { "key": "keyword", "value": "chair" }
              ]
            },
            "description": "Alias for GET /products — delegates to the same handler.\nAccess: CUSTOMER"
          }
        },
        {
          "name": "GET /products/category/{category}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/category/FURNITURE",
              "host": ["{{baseUrl}}"],
              "path": ["products", "category", "FURNITURE"]
            },
            "description": "Filter by category via path variable. Categories: ELECTRONICS, ELECTRICAL, FURNITURE, COSMETICS, TOYS, BOOKS.\nAccess: CUSTOMER"
          }
        },
        {
          "name": "GET /products/{id}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/1",
              "host": ["{{baseUrl}}"],
              "path": ["products", "1"]
            },
            "description": "Product detail page — name, description, price, stock, category. Includes add-to-cart form.\nAccess: CUSTOMER\nOutput: products/detail.html"
          }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "GET /cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart",
              "host": ["{{baseUrl}}"],
              "path": ["cart"]
            },
            "description": "View current user's cart. Creates empty cart if none exists. Shows items, quantities, subtotals, grand total.\nAccess: CUSTOMER\nOutput: cart/cart.html"
          }
        },
        {
          "name": "POST /cart/add",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "productId", "value": "3", "type": "text" },
                { "key": "quantity", "value": "2", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/cart/add",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "add"]
            },
            "description": "Add a product to the cart. Validates stock — rejects if out of stock or qty exceeds available. If already in cart, increments quantity.\nAccess: CUSTOMER\nSuccess: 302 → /cart\nFailure: 302 → /products/{id} with flash error"
          }
        },
        {
          "name": "POST /cart/update",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "cartItemId", "value": "5", "type": "text" },
                { "key": "quantity", "value": "3", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/cart/update",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "update"]
            },
            "description": "Change the quantity of an existing cart item.\nAccess: CUSTOMER\nOutput: 302 → /cart"
          }
        },
        {
          "name": "POST /cart/remove/{itemId}",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/remove/5",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "remove", "5"]
            },
            "description": "Remove a single item from the cart by cart-item ID (not product ID).\nAccess: CUSTOMER\nOutput: 302 → /cart"
          }
        },
        {
          "name": "POST /cart/clear",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cart/clear",
              "host": ["{{baseUrl}}"],
              "path": ["cart", "clear"]
            },
            "description": "Empty the entire cart. Cart row is kept; only CartItems are deleted via orphanRemoval.\nAccess: CUSTOMER\nOutput: 302 → /cart"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "POST /orders/place",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "shippingAddress", "value": "42 MG Road, Bengaluru, Karnataka 560001", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/orders/place",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "place"]
            },
            "description": "Place order from cart. Atomically: validates stock, deducts inventory, creates Order + OrderItems, clears cart, sends async confirmation email. Requires non-empty cart and non-blank shippingAddress.\nAccess: CUSTOMER\nSuccess: 302 → /orders/{newOrderId}\nFailure: 302 → /cart with flash error"
          }
        },
        {
          "name": "GET /orders",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["orders"]
            },
            "description": "Order history. CUSTOMERs see own orders only. ADMINs see all orders sorted newest-first.\nAccess: CUSTOMER / ADMIN\nOutput: orders/history.html"
          }
        },
        {
          "name": "GET /orders/{id}",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/7",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "7"]
            },
            "description": "Full order detail — items, quantities, prices, subtotals, total, status, shipping address. CUSTOMERs can only view their own orders.\nAccess: CUSTOMER (own) / ADMIN\nOutput: orders/details.html with order and canCancel flag"
          }
        },
        {
          "name": "GET /orders/{id}/cancel",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/7/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "7", "cancel"]
            },
            "description": "Cancellation confirmation page. If order is not cancellable (already shipped/delivered/cancelled), redirects back to order detail instead.\nAccess: CUSTOMER (own) / ADMIN\nOutput: orders/cancel-confirm.html"
          }
        },
        {
          "name": "POST /orders/{id}/cancel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "JSESSIONID={{sessionId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders/7/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["orders", "7", "cancel"]
            },
            "description": "Cancels the order — sets status to CANCELLED and restores inventory quantities.\nAccess: CUSTOMER (own) / ADMIN\nSuccess: 302 → /orders/{id} with flash success\nFailure: 302 → /orders/{id} with flash error"
          }
        }
      ]
    },
