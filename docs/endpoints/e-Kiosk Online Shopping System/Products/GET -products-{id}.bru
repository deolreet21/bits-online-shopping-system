meta {
  name: GET /products/{id}
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/products/1
  body: none
  auth: inherit
}

headers {
  Cookie: JSESSIONID={{sessionId}}
}

settings {
  encodeUrl: true
}

docs {
  Product detail page — name, description, price, stock, category. Includes add-to-cart form.
  Access: CUSTOMER
  Output: products/detail.html
}
